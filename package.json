{
  "name": "mk9-lobby-companion",
  "version": "0.1.0",
  "description": "Plataforma web de salas privadas para organizar partidas online de Mortal Kombat 9 (Komplete Edition). No incluye ni ejecuta el juego.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:e2e": "node scripts/e2e-browser.cjs",
    "test:stream": "node scripts/e2e-stream.cjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonelchamorrocajahuaman1-glitch/Mortal-Kombat-9.git"
  }
}
