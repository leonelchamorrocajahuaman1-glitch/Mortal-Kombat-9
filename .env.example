# Copia este archivo como .env solo para tu referencia: el servidor lee variables de entorno
# del sistema o del servicio de alojamiento (no carga .env automáticamente). No subas .env a Git.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
RECONNECT_GRACE_MS=60000
HEARTBEAT_MS=2000
DEAD_AFTER_MS=10000
MAX_ROOMS=500
ROOM_IDLE_MS=21600000
# Separadas por comas. Vacío = cualquier origen.
ALLOWED_ORIGINS=
# Ejemplo con TURN propio (las credenciales van en el panel del hosting, nunca en el repositorio):
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.ejemplo.com:3478","username":"usuario","credential":"secreto"}]
ICE_SERVERS=
